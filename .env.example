# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:54329/sentinel
REDIS_URL=redis://localhost:63799/0

# LLM: auto uses Claude when Anthropic credentials exist, otherwise the offline heuristic engine.
LLM_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Embeddings: auto uses Voyage when VOYAGE_API_KEY is set, otherwise a local hashing embedder.
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=

# Auth: "clerk" in any shared environment. "dev" trusts X-Dev-* headers and is refused in production.
AUTH_MODE=dev
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=

# Internal token for global operations such as triggering a scrape.
INTERNAL_API_TOKEN=change-me

# Storage: "local" writes under DATA_DIR. "s3" uses any S3-compatible store such as Tigris on Fly.
STORAGE_BACKEND=local
DATA_DIR=./data
S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Alerts
RESEND_API_KEY=
ALERT_FROM_EMAIL=sentinel@example.com
DASHBOARD_URL=http://localhost:3000

# Report approval: when true, a run pauses before the report until an auditor approves it.
REQUIRE_APPROVAL=true
