# Clerk keys from the dashboard. Leave empty in local dev to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where the FastAPI service runs.
SENTINEL_API_URL=http://localhost:8000
# "dev" forwards the Clerk user, org and role as X-Dev-* headers to an API running AUTH_MODE=dev.
# Use "clerk" whenever the API verifies Clerk tokens itself (staging and production).
SENTINEL_AUTH_MODE=dev
